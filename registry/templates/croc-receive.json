{
  "id": "croc-receive",
  "name": "croc receive",
  "description": "croc 接收——输入发送方给出的接收码领收文件（发送方用「croc send」）。自动接受(--yes)，保存到接收目录。若提示 could not secure channel，可在「中继地址」两端填同一个自建中继（先用「croc relay」模板启动，host 填 127.0.0.1:9009）。",
  "repo": "schollz/croc",
  "binary": "croc",
  "category": "file-sharing",
  "assets": {
    "darwin": {
      "candidates": ["croc_v{version}_macOS-ARM64.tar.gz", "croc_v{version}_macOS-64bit.tar.gz"],
      "format": "tar.gz",
      "mode": "single",
      "member": "croc"
    },
    "linux": {
      "candidates": ["croc_v{version}_Linux-ARM64.tar.gz", "croc_v{version}_Linux-64bit.tar.gz"],
      "format": "tar.gz",
      "mode": "single",
      "member": "croc"
    },
    "windows": {
      "candidates": ["croc_v{version}_Windows-64bit.tar.gz"],
      "format": "tar.gz",
      "mode": "single",
      "member": "croc.exe"
    }
  },
  "arch_map": {
    "x86_64": "64bit",
    "aarch64": "ARM64"
  },
  "fields": [
    { "key": "code", "kind": "string", "label": "接收码", "default": "", "placeholder": "发送方给的码（两端一致），如 12345678" },
    { "key": "receive_dir", "kind": "directory", "label": "接收目录", "default": ".", "placeholder": "文件保存位置（--out），缺省为程序目录" },
    { "key": "relay", "kind": "string", "label": "中继地址", "default": "", "placeholder": "默认官方中继；自建填 127.0.0.1:9009，两端一致" }
  ],
  "env": [
    { "key": "CROC_SECRET", "value": "{code}", "label": "共享密钥（两端一致，直接等于接收码）" },
    { "key": "CROC_RELAY", "value": "{relay}", "label": "中继地址（留空用默认官方中继）" }
  ],
  "args": ["--yes", "--out", "{receive_dir}"]
}