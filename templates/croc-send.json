{
  "id": "croc-send",
  "name": "croc send",
  "description": "croc 发送——把文件/文件夹推送给对方，对方用「croc receive」输码接收。端到端加密，无需服务器。",
  "repo": "schollz/croc",
  "binary": "croc",
  "category": "file-sharing",
  "assets": {
    "darwin": {
      "candidates": ["croc_v{version}_macOS-ARM64.tar.gz", "croc_v{version}_macOS-64bit.tar.gz"],
      "format": "tar.gz",
      "mode": "single",
      "member": "croc"
    },
    "linux": {
      "candidates": ["croc_v{version}_Linux-ARM64.tar.gz", "croc_v{version}_Linux-64bit.tar.gz"],
      "format": "tar.gz",
      "mode": "single",
      "member": "croc"
    },
    "windows": {
      "candidates": ["croc_v{version}_Windows-64bit.tar.gz"],
      "format": "tar.gz",
      "mode": "single",
      "member": "croc.exe"
    }
  },
  "arch_map": {
    "x86_64": "64bit",
    "aarch64": "ARM64"
  },
  "fields": [
    { "key": "code", "kind": "string", "label": "发送码", "default": "", "placeholder": "至少 6 位，接收方输入同一串码，如 12345678" },
    { "key": "args_extra", "kind": "string", "label": "发送文件/参数", "default": "", "placeholder": "文件/目录路径，或 --zip 目录，如 ./photo.jpg" }
  ],
  "env": [
    { "key": "CROC_SECRET", "value": "croc-{code}", "label": "共享密钥（两端一致，缺省为 croc- 加发送码）" }
  ],
  "args": ["send", "--code", "{code}", "{args_extra}"]
}