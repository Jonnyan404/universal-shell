{
  "id": "croc-send",
  "name": "croc send",
  "description": "croc 发送——把文件/文件夹推送给对方，对方用「croc receive」输码接收。端到端加密，无需服务器。",
  "repo": "schollz/croc",
  "binary": "croc",
  "category": "file-sharing",
  "assets": {
    "darwin": {
      "candidates": ["croc_v{version}_macOS-ARM64.tar.gz", "croc_v{version}_macOS-64bit.tar.gz"],
      "format": "tar.gz",
      "mode": "single",
      "member": "croc"
    },
    "linux": {
      "candidates": ["croc_v{version}_Linux-ARM64.tar.gz", "croc_v{version}_Linux-64bit.tar.gz"],
      "format": "tar.gz",
      "mode": "single",
      "member": "croc"
    },
    "windows": {
      "candidates": ["croc_v{version}_Windows-64bit.tar.gz"],
      "format": "tar.gz",
      "mode": "single",
      "member": "croc.exe"
    }
  },
  "arch_map": {
    "x86_64": "64bit",
    "aarch64": "ARM64"
  },
  "fields": [
    { "key": "args_extra", "kind": "string", "label": "发送参数", "default": "", "placeholder": "--code 12位码 接文件路径，如 --code 12345678 ./photo.jpg" }
  ],
  "args": ["send", "{args_extra}"]
}