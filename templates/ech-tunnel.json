{
  "id": "ech-tunnel",
  "name": "ech-tunnel 客户端",
  "description": "ech-tunnel — ECH 加密 WebSocket 安全隧道代理（TCP 转发 / SOCKS5-HTTP 代理），TLS 1.3 + ECH 隐藏 SNI。客户端网络监听地址默认 127.0.0.1。",
  "repo": "badafans/ech-tunnel",
  "binary": "ech-tunnel",
  "category": "proxy",
  "assets": {
    "darwin": {
      "candidates": ["ech-tunnel-darwin-{arch}", "ech-tunnel-darwin-amd64", "ech-tunnel-darwin-arm64"],
      "format": "raw",
      "mode": "raw"
    },
    "linux": {
      "candidates": ["ech-tunnel-linux-{arch}", "ech-tunnel-linux-amd64", "ech-tunnel-linux-arm64"],
      "format": "raw",
      "mode": "raw"
    },
    "windows": {
      "candidates": ["ech-tunnel-windows-{arch}.exe", "ech-tunnel-windows-amd64.exe", "ech-tunnel-windows-arm64.exe"],
      "format": "raw",
      "mode": "raw"
    }
  },
  "arch_map": {
    "x86_64": "amd64",
    "aarch64": "arm64"
  },
  "fields": [
    { "key": "listen", "kind": "string", "label": "本地监听地址", "default": "127.0.0.1:1080", "placeholder": "proxy://127.0.0.1:1080 / wss://0.0.0.0:8443/tunnel / tcp://127.0.0.1:8080/内网:端口", "required": true },
    { "key": "forward", "kind": "string", "label": "服务端地址", "default": "", "placeholder": "客户端: 服务器:8443/tunnel", "required": true },
    { "key": "token", "kind": "string", "label": "身份令牌", "default": "", "placeholder": "与服务端一致的 token（可留空）" },
    { "key": "channels", "kind": "string", "label": "预连接通道数", "default": "3", "placeholder": "3" },
    { "key": "ip", "kind": "string", "label": "优选IP/域名", "default": "", "placeholder": "例如 1.1.1.1, 2.2.2.2" },
    { "key": "extra", "kind": "string", "label": "附加参数", "default": "", "placeholder": "-fallback -cert cert.pem -key key.pem -ech cloudflare.com -dns doh.pub/dns-query" }
  ],
  "args": ["-l", "proxy://{listen}", "-f", "wss://{forward}", "-token", "{token}", "-n", "{channels}", "-ip", "{ip}", "{extra}"]
}