{
  "programs": [
    {
      "id": "cloud-clipboard-go",
      "name": "cloud-clipboard-go",
      "description": "云剪贴板核心程序 (Go)。展示全部字段类型，含文件路径、目录、开机启动复选框。",
      "repo": "Jonnyan404/cloud-clipboard-go",
      "binary": "cloud-clipboard-go",
      "working_dir": ".",
      "assets": {
        "darwin": {
          "candidates": ["{name}_Darwin_{arch}.tar.gz"],
          "format": "tar.gz",
          "member": "cloud-clipboard-go"
        },
        "linux": {
          "candidates": ["{name}_Linux_{arch}.tar.gz"],
          "format": "tar.gz",
          "member": "cloud-clipboard-go"
        },
        "windows": {
          "candidates": ["{name}_Windows_{arch}.zip"],
          "format": "zip",
          "member": "cloud-clipboard-go.exe"
        }
      },
      "arch_map": {
        "x86_64": "x86_64",
        "aarch64": "arm64"
      },
      "fields": [
        {
          "key": "host",
          "kind": "string",
          "label": "监听地址",
          "default": "0.0.0.0",
          "placeholder": "0.0.0.0"
        },
        {
          "key": "port",
          "kind": "string",
          "label": "端口",
          "default": "9000",
          "placeholder": "9000"
        },
        {
          "key": "config",
          "kind": "file",
          "label": "配置文件",
          "default": "",
          "filter": "*.json,*.yaml,*.toml"
        },
        {
          "key": "data_dir",
          "kind": "directory",
          "label": "数据目录",
          "default": ""
        },
        {
          "key": "verbose",
          "kind": "boolean",
          "label": "详细日志",
          "default": false
        },
        {
          "key": "autostart",
          "kind": "autostart",
          "label": "开机启动",
          "default": false
        }
      ],
      "args": [
        "-host",
        "{host}",
        "-port",
        "{port}",
        "-config",
        "{config}",
        "-dir",
        "{data_dir}"
      ]
    },
    {
      "id": "demo-echo",
      "name": "演示程序 (echo)",
      "description": "一个本地测试用示例：字段全部走 -arg {value} 模板，打印到日志。",
      "repo": "Jonnyan404/does-not-exist",
      "binary": "demo-echo",
      "working_dir": ".",
      "args": ["-name", "{name}", "-interval", "{interval}"],
      "fields": [
        {
          "key": "name",
          "kind": "string",
          "label": "名称",
          "default": "world",
          "placeholder": "world"
        },
        {
          "key": "interval",
          "kind": "string",
          "label": "间隔(秒)",
          "default": "5",
          "placeholder": "5"
        }
      ]
    }
  ],
  "template_registries": [
    "https://raw.githubusercontent.com/Jonnyan404/universal-shell/main/registry/"
  ],
  "registry_pubkeys": {
    "https://raw.githubusercontent.com/Jonnyan404/universal-shell/main/registry/": "4cb5abf6ad79fbf5abbccafcc269d85cd2651ed4b885b5869f241aedf0a5ba29"
  }
}